.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}

.user-section {
  display: flex;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.user-welcome {
  display: block;
  font-size: 24rpx;
  color: #B0B0B0;
}

.stats-section {
  display: flex;
  padding: 0 32rpx 48rpx;
  background: rgba(255, 255, 255, 0.02);
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #B0B0B0;
}

.menu-section {
  margin: 0 32rpx 32rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  transition: all 0.3s;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-title {
  font-size: 32rpx;
  color: #FFFFFF;
}

.menu-arrow {
  font-size: 48rpx;
  color: #B0B0B0;
}

.menu-item.danger .menu-title {
  color: #FF6B6B;
}

.danger-section {
  margin: 0 32rpx;
}

.danger-section .menu-item {
  background: rgba(255, 107, 107, 0.05);
  border: 1rpx solid rgba(255, 107, 107, 0.1);
}
