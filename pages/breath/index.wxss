.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.breath-circle-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.breath-circle {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 2s ease-in-out;
  position: relative;
  box-shadow: 0 0 60rpx rgba(74, 144, 217, 0.3);
}

.circle-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phase-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.countdown {
  font-size: 120rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

.breath-info {
  text-align: center;
  margin-bottom: 64rpx;
}

.round-info {
  display: block;
  font-size: 32rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.breath-tips {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.control-area {
  width: 100%;
}

.completed-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.completed-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.completed-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 64rpx;
}

.completed-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #fff;
}

.btn-secondary {
  background: linear-gradient(135deg, #FFB347 0%, #FFA500 100%);
  color: #fff;
}
