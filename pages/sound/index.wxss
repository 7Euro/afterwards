.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 48rpx 32rpx 160rpx;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #B0B0B0;
}

.sound-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.sound-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  position: relative;
  border: 2rpx solid transparent;
}

.sound-card:active {
  transform: scale(0.95);
}

.sound-card.playing {
  background: rgba(74, 144, 217, 0.1);
  border-color: rgba(74, 144, 217, 0.3);
}

.sound-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.sound-card.playing .sound-icon {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.1);
  }
}

.sound-name {
  font-size: 32rpx;
  color: #FFFFFF;
}

.sound-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-dot {
  width: 100%;
  height: 100%;
  background: #4A90D9;
  border-radius: 50%;
  animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

.volume-slider {
  width: 100%;
  margin-top: 24rpx;
}

.tips {
  margin-top: 48rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #B0B0B0;
}

/* 悬浮播放条 */
.floating-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(22, 33, 62, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bar-text {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.bar-count {
  font-size: 24rpx;
  color: #B0B0B0;
}

.stop-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 107, 107, 0.2);
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FF6B6B;
  line-height: 1;
  margin-left: 24rpx;
  transition: all 0.3s;
}

.stop-btn:active {
  background: rgba(255, 107, 107, 0.3);
}
