.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  position: relative;
  overflow: hidden;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  z-index: 10;
}

.back-btn {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #B0B0B0;
}

.back-icon {
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
}

.content-area {
  flex: 1;
  padding: 0 32rpx;
  position: relative;
}

.content-textarea {
  width: 100%;
  min-height: 80vh;
  padding: 32rpx 0;
  font-size: 32rpx;
  line-height: 1.8;
  color: #FFFFFF;
  background: transparent;
  border: none;
  outline: none;
}

.content-textarea::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.content-textarea.destroying {
  animation: destroyAnimation 2s ease-out forwards;
}

@keyframes destroyAnimation {
  0% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.5;
    transform: scale(1.05);
  }

  100% {
    opacity: 0;
    transform: scale(1.1) translateY(-20rpx);
  }
}

/* 粒子效果 */
.particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.3;
  }

  50% {
    transform: translateY(-40rpx) scale(1.5);
    opacity: 0.6;
  }
}

.result-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 48rpx;
  animation: fadeIn 0.5s ease-out;
}

.result-text {
  font-size: 36rpx;
  text-align: center;
  line-height: 1.6;
  color: #FFFFFF;
  margin-bottom: 64rpx;
  animation: fadeIn 0.5s ease-out 0.3s both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bottom-actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
}

.btn-danger {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%);
  color: #fff;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #fff;
}
