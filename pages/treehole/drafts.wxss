.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}

.header {
  padding: 48rpx 32rpx 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.draft-list {
  padding: 0 32rpx;
}

.draft-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg-card);
  height: 180rpx;
}

.card-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: var(--color-bg-card);
  transition: transform 0.3s;
  display: flex;
  flex-direction: column;
}

.draft-text {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.draft-date {
  font-size: 24rpx;
  color: #B0B0B0;
  margin-top: 16rpx;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  background: #FF6B6B;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s;
}

.delete-text {
  font-size: 28rpx;
  color: #FFFFFF;
}
