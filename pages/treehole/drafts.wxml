<view class="page">
  <view class="header">
    <text class="title">草稿箱</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{drafts.length === 0}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">还没有保存的草稿</text>
    <text class="empty-hint">去写点什么吧</text>
  </view>

  <!-- 草稿列表 -->
  <view class="draft-list" wx:else>
    <view
      class="draft-card"
      wx:for="{{drafts}}"
      wx:key="id"
      bindtap="resetCard"
      data-index="{{index}}"
    >
      <view
        class="card-content"
        style="transform: translateX({{item.offset || 0}}px)"
        bindtap="viewDraft"
        data-draft="{{item}}"
        bindtouchstart="touchStart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
        data-index="{{index}}"
      >
        <text class="draft-text">{{item.content}}</text>
        <text class="draft-date">{{item.createdAt | formatDate}}</text>
      </view>

      <view
        class="delete-btn"
        style="transform: translateX({{(item.offset || 0) + deleteBtnWidth}}px)"
        bindtap="deleteDraft"
        data-index="{{index}}"
      >
        <text class="delete-text">删除</text>
      </view>
    </view>
  </view>
</view>

<wxs module="filter">
var formatDate = function(timestamp) {
  var date = getDate(timestamp);
  var month = date.getMonth() + 1;
  var day = date.getDate();
  var hour = date.getHours();
  var minute = date.getMinutes();

  month = month < 10 ? '0' + month : month;
  day = day < 10 ? '0' + day : day;
  hour = hour < 10 ? '0' + hour : hour;
  minute = minute < 10 ? '0' + minute : minute;

  return month + '月' + day + '日 ' + hour + ':' + minute;
};

module.exports.formatDate = formatDate;
</wxs>
