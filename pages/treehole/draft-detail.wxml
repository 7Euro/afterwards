<view class="page" wx:if="{{draft}}">
  <view class="content-area">
    <text class="draft-content">{{draft.content}}</text>
  </view>

  <!-- 悬浮删除按钮 -->
  <view class="delete-action">
    <button class="btn btn-danger" bindtap="handleDelete">
      <text class="btn-icon">🗑</text>
      <text class="btn-text">删除草稿</text>
    </button>
  </view>
</view>
