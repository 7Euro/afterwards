<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <text class="title">每天给自己5分钟</text>
    <text class="subtitle">让情绪有个出口</text>
  </view>

  <view class="content">
    <!-- 今日打卡入口 -->
    <view class="quick-card" bindtap="goToCheckin">
      <view class="card-icon checkin-icon">📝</view>
      <view class="card-content">
        <text class="card-title">今日打卡</text>
        <text class="card-desc">{{todayChecked ? '今天已记录' : '记录今天的情绪'}}</text>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <!-- 快捷工具 -->
    <view class="section-title">快捷工具</view>

    <view class="tool-grid">
      <view class="tool-card" bindtap="goToWrite">
        <text class="tool-icon">✍️</text>
        <text class="tool-name">写下来</text>
        <view wx:if="{{draftCount > 0}}" class="draft-badge">{{draftCount}}</view>
      </view>

      <view class="tool-card" bindtap="goToSound">
        <text class="tool-icon">🎵</text>
        <text class="tool-name">声音空间</text>
      </view>

      <view class="tool-card" bindtap="goToBreath">
        <text class="tool-icon">🌬️</text>
        <text class="tool-name">呼吸引导</text>
      </view>

      <view class="tool-card" bindtap="goToMine">
        <text class="tool-icon">👤</text>
        <text class="tool-name">我的</text>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tip-card">
      <text class="tip-icon">💡</text>
      <text class="tip-text">在这里,你的情绪只有自己知道</text>
    </view>
  </view>
</view>
