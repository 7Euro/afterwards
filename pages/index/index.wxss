.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}

.header {
  padding: 48rpx 32rpx 64rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 32rpx;
  color: #B0B0B0;
}

.content {
  padding: 0 32rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.2) 0%, rgba(58, 123, 200, 0.2) 100%);
  border: 2rpx solid rgba(74, 144, 217, 0.3);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: rgba(74, 144, 217, 0.3);
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #B0B0B0;
}

.card-arrow {
  font-size: 48rpx;
  color: #B0B0B0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #B0B0B0;
  margin-bottom: 24rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.tool-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  transition: all 0.3s;
}

.tool-card:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.08);
}

.tool-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.tool-name {
  font-size: 28rpx;
  color: #FFFFFF;
}

.draft-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 8rpx;
  background: #FF6B6B;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-card {
  display: flex;
  align-items: center;
  background: rgba(255, 179, 71, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #FFB347;
  line-height: 1.5;
}
