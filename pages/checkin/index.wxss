.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 48rpx 32rpx;
}

.checked-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.checked-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.checked-text {
  font-size: 36rpx;
  color: #FFFFFF;
  margin-bottom: 64rpx;
}

.form-container {
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.title-section {
  margin-bottom: 64rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #B0B0B0;
}

.section {
  margin-bottom: 48rpx;
}

.section-label {
  display: block;
  font-size: 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.score-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.score-label {
  font-size: 24rpx;
  color: #B0B0B0;
  width: 100rpx;
  text-align: center;
}

.score-low {
  text-align: left;
}

.score-high {
  text-align: right;
}

.score-slider {
  flex: 1;
  margin: 0 16rpx;
}

.score-display {
  display: block;
  text-align: center;
  font-size: 64rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx -12rpx 0;
}

.tag {
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
  font-size: 32rpx;
  color: #333333;
  background: #E8E8E8;
  margin: 0 12rpx 12rpx 0;
  border: none;
}

.tag:active {
  opacity: 0.7;
}

.tag-active {
  background: #4CAF50 !important;
  color: #FFFFFF !important;
  font-weight: bold !important;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  line-height: 1.6;
}

.note-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.note-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #B0B0B0;
  margin-top: 12rpx;
}

.submit-section {
  padding-top: 32rpx;
}

.btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #fff;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: linear-gradient(135deg, #FFB347 0%, #FFA500 100%);
  color: #fff;
}

.completed-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  animation: fadeIn 0.5s ease-out;
}

.completed-icon {
  font-size: 160rpx;
  color: #4A90D9;
  margin-bottom: 32rpx;
}

.completed-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.completed-hint {
  font-size: 28rpx;
  color: #B0B0B0;
}
