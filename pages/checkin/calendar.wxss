.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 48rpx 32rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 32rpx;
  color: #FFFFFF;
  transition: all 0.3s;
}

.nav-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.month-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.today-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #4A90D9;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  margin: 0 auto 32rpx;
  width: fit-content;
}

.today-btn:active {
  opacity: 0.8;
}

.today-btn-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.today-btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.week-header {
  display: flex;
  margin-bottom: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #B0B0B0;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s;
  border: 3rpx solid transparent;
}

.day-cell.today {
  background: rgba(74, 144, 217, 0.15);
}

.day-cell.selected {
  border-color: #FFFFFF !important;
  background: rgba(255, 255, 255, 0.15) !important;
}

.day-cell.selected .day-number {
  color: #FFFFFF;
  font-weight: bold;
  font-size: 32rpx;
}

.day-cell:active {
  transform: scale(0.95);
}

.day-number {
  font-size: 28rpx;
  color: #FFFFFF;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 48rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.legend-text {
  font-size: 24rpx;
  color: #B0B0B0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.detail-content {
  width: 100%;
  max-width: 600rpx;
  background: #16213e;
  border-radius: 24rpx;
  padding: 48rpx;
  position: relative;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.detail-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #B0B0B0;
  line-height: 1;
}

.detail-header {
  margin-bottom: 32rpx;
}

.detail-date {
  display: block;
  font-size: 28rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.detail-score {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.detail-tag {
  padding: 12rpx 24rpx;
  background: rgba(74, 144, 217, 0.2);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #4A90D9;
}

.detail-note {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.note-label {
  display: block;
  font-size: 24rpx;
  color: #B0B0B0;
  margin-bottom: 12rpx;
}

.note-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
}
