/* 颜色变量 */
page {
  --color-primary: #4A90D9;
  --color-primary-dark: #3A7BC8;
  --color-secondary: #FFB347;
  --color-danger: #FF6B6B;
  --color-bg-dark: #1a1a2e;
  --color-bg-card: #16213e;
  --color-text-primary: #FFFFFF;
  --color-text-secondary: #B0B0B0;
  --color-border: rgba(255, 255, 255, 0.1);
}

/* 全局字体 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: var(--color-text-primary);
  background: var(--color-bg-dark);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 容器 */
.container {
  padding: 0 32rpx;
}

/* 卡片样式 */
.card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #fff;
}

.btn-danger {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%);
  color: #fff;
}

.btn-secondary {
  background: linear-gradient(135deg, #FFB347 0%, #FFA500 100%);
  color: #fff;
}

/* 文字样式 */
.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-title {
  font-size: 40rpx;
  font-weight: 600;
}

.text-subtitle {
  font-size: 32rpx;
  font-weight: 600;
}

.text-body {
  font-size: 28rpx;
  font-weight: 400;
}

.text-caption {
  font-size: 24rpx;
  font-weight: 400;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
  background: rgba(255, 255, 255, 0.1);
  color: var(--color-text-secondary);
  transition: all 0.3s;
}

.tag.active {
  background: var(--color-primary);
  color: #fff;
}

.tag:active {
  transform: scale(0.95);
}
